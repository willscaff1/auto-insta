# Railway cria PORT e DATABASE_URL automaticamente.
APP_TIMEZONE=America/Cuiaba
ADMIN_API_KEY=troque-por-uma-chave-longa
PUBLIC_BASE_URL=https://seu-projeto.up.railway.app

# Comece em dry_run. Troque para live depois do teste privado.
PUBLISHING_MODE=dry_run
SCHEDULER_ENABLED=true
SCHEDULER_POLL_MS=30000
MIN_READY_FEED_POSTS=10

# Meta for Developers / Instagram professional account
META_API_VERSION=v24.0
META_IG_USER_ID=
META_ACCESS_TOKEN=

# Pesquisa e reposição diária da fila
AUTO_RESEARCH_ENABLED=false
AUTO_APPROVE_RESEARCH=false
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-luna
